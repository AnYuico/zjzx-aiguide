<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tzp.zjzx.user.mapper.RegionMapper">

    <resultMap id="regionMap" type="com.tzp.zjzx.model.entity.base.Region" autoMapping="true"/>

    <sql id="columns">
        id,code,parent_code,name,level,create_time,update_time,is_deleted
    </sql>

    <select id="findChildren" resultMap="regionMap">
        select <include refid="columns"/>
        from region
        where parent_code = #{parentCode}
          and is_deleted = 0
        order by code
    </select>

    <select id="findByCode" resultMap="regionMap">
        select <include refid="columns"/>
        from region
        where code = #{code}
          and is_deleted = 0
        limit 1
    </select>
</mapper>
